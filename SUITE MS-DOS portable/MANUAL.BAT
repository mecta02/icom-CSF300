@ECHO OFF

:LOOPHERE

CLS
REM ECHO [44m
ECHO.
ECHO.
ECHO                MAKE CHOICE FOR MANUAL YOU WANT TO PRINT:
ECHO.
ECHO                    [F1]  -  FTH-2070
ECHO.
ECHO                    [F2]  -  FTH-2008/7008, FTH-2009/7009
ECHO.
ECHO                    [F3]  -  FTL-1011/2011/7011 4/12/24 CHANNEL
ECHO.
ECHO                    [F4]  -  VX-500  VHF/UHF
ECHO.
ECHO                    [F10] -  RETURN TO MAIN MENU

@ECHO OFF
:RDKEY

F1TOF10

IF ERRORLEVEL 69 GOTO RD_KEY
IF ERRORLEVEL 68 GOTO DONEP
IF ERRORLEVEL 59 IF NOT ERRORLEVEL 60 GOTO P2070 
IF ERRORLEVEL 60 IF NOT ERRORLEVEL 61 GOTO PCE2 
IF ERRORLEVEL 61 IF NOT ERRORLEVEL 62 GOTO PCE5  
IF ERRORLEVEL 62 IF NOT ERRORLEVEL 63 GOTO PCE6  
IF ERRORLEVEL 63 IF NOT ERRORLEVEL 64 GOTO RDKEY
IF ERRORLEVEL 64 IF NOT ERRORLEVEL 65 GOTO RDKEY
IF ERRORLEVEL 65 IF NOT ERRORLEVEL 66 GOTO RDKEY
IF ERRORLEVEL 66 IF NOT ERRORLEVEL 67 GOTO RDKEY
IF ERRORLEVEL 67 IF NOT ERRORLEVEL 68 GOTO RDKEY
IF ERRORLEVEL 68 IF NOT ERRORLEVEL 69 DONEP

GOTO  LOOPHERE

:P2070
CLS
ECHO.
ECHO.
ECHO.
ECHO PREPARE PRINTER.
ECHO.
PAUSE
TYPE 2070.MAN>PRN
ECHO.
ECHO PRINTING OF MANUALS COMPLETE.
ECHO.
PAUSE

GOTO LOOPHERE

